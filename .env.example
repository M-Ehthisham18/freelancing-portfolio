# ── Public ──────────────────────────────────────────────────────────
# Canonical site origin. Set to the deployed domain in production, e.g.:
# NEXT_PUBLIC_SITE_URL=https://www.example.com
# Used by canonical URLs, Open Graph, robots.txt, and sitemap.xml.
# Falls back to http://localhost:3000 during development.
NEXT_PUBLIC_SITE_URL=

# ── Server-side ─────────────────────────────────────────────────────
# Resend API key used by the server-side contact API
RESEND_API_KEY=

# Verified sender address/domain configured in Resend
CONTACT_FROM_EMAIL=

# Email address that should receive new client inquiries
CONTACT_TO_EMAIL=
